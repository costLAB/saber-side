{
  "name": "@saber-side/server",
  "private": true,
  "type": "module",
  "description": "The station server: one Colyseus room for the whole friend group, saved in SQLite.",
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --testTimeout=30000"
  },
  "dependencies": {
    "@colyseus/core": "0.18.19",
    "@colyseus/schema": "5.0.40",
    "@colyseus/ws-transport": "0.18.4",
    "@saber-side/shared": "workspace:*",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "vitest": "5.0.4"
  }
}
