{
  "name": "saber-side",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:https": "HTTPS=1 pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @saber-side/client preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @saber-side/client e2e",
    "e2e:update": "pnpm --filter @saber-side/client e2e:update",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2"
  }
}
